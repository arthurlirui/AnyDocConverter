FROM python:3.12-slim

LABEL maintainer="devops@pdf-platform"
LABEL description="PDF Platform — Celery Worker"

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies: GL rendering, Poppler, Tesseract OCR (Chinese), CJK fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Install additional PDF processing libraries + Celery with Redis transport.
# Note: pdf2docx is required by algo/converters/to_docx_converter.py.
RUN pip install --no-cache-dir \
    pymupdf \
    python-docx \
    openpyxl \
    python-pptx \
    Pillow \
    pdf2image \
    pdf2docx \
    pdfplumber \
    reportlab \
    weasyprint \
    celery[redis]

# Install PaddleOCR (PP-OCRv4, stable) — CPU version
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    "paddlepaddle>=2.6.0,<3.0" \
    "paddleocr>=2.9.0,<3.0"

# Copy application source
COPY backend/ /app/backend/
COPY algo/ /app/algo/

# PYTHONPATH must include /app (so `import algo` resolves to /app/algo/)
# and /app/backend (so `import app...` resolves to /app/backend/app/...).
ENV PYTHONPATH=/app:/app/backend

# Celery worker entry point.
# - `-A workers.celery:celery_app` explicitly targets the Celery instance
#   (the attribute is named `celery_app`, not the default `app`/`celery`).
# - `-Q conversions,pdf-platform-default` subscribes to both the routed
#   conversion queue and the default queue; without this the worker only
#   listens on the implicit `celery` queue and never receives tasks
#   (see backend/workers/celery.py task_routes).
CMD ["celery", "-A", "workers.celery:celery_app", "worker", "-Q", "conversions,pdf-platform-default", "--loglevel=info", "--concurrency=2"]
