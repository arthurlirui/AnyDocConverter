FROM python:3.12-slim

LABEL maintainer="devops@pdf-platform"
LABEL description="PDF Platform — FastAPI Backend"

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies: GL rendering, Poppler, Tesseract OCR (Chinese), CJK fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Install additional PDF processing libraries
RUN pip install --no-cache-dir \
    pymupdf \
    python-docx \
    openpyxl \
    python-pptx \
    Pillow \
    pdf2image \
    pdfplumber \
    reportlab \
    weasyprint

# Install PaddleOCR (PP-OCRv4, stable) — CPU version (for direct API calls)
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    "paddlepaddle>=2.6.0,<3.0" \
    "paddleocr>=2.9.0,<3.0"

# Copy application source
COPY backend/ /app/backend/
COPY algo/ /app/algo/

# The app package lives in backend/app, but algo is at /app/algo
# PYTHONPATH ensures both are importable
ENV PYTHONPATH=/app/backend:/app/algo

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
