# ============================================================
# Stage 1: Build Next.js standalone server
# ============================================================
FROM node:20-alpine AS builder

LABEL maintainer="devops@pdf-platform"
LABEL description="PDF Platform — Frontend Builder"

WORKDIR /app

# Copy dependency manifests first for better layer caching
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# Copy the rest of the frontend source
COPY frontend/ ./

# Build the Next.js standalone output
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=
RUN npm run build

# ============================================================
# Stage 2: Serve via Node.js runtime
# ============================================================
FROM node:20-alpine

LABEL maintainer="devops@pdf-platform"
LABEL description="PDF Platform — Frontend (standalone server)"

WORKDIR /app

# Copy standalone output from builder
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_API_URL=

CMD ["node", "server.js"]
